{
	"name": "@edgarjaymez/grove",
	"version": "0.44.0",
	"description": "Grove — Lit Components UI Kit",
	"license": "MIT",
	"author": {
		"name": "Edgar Diaz",
		"url": "https://edgarjaymez.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/edgarjaymez/grove-lit.git"
	},
	"homepage": "https://grove.edgarjaymez.com",
	"bugs": {
		"url": "https://github.com/edgarjaymez/grove-lit/issues"
	},
	"scripts": {
		"build": "pnpm build-tokens && vite build",
		"prepack": "pnpm build && publint",
		"check": "tsc --noEmit",
		"check:watch": "tsc --noEmit --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"build-tokens": "tz build"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css",
		"**/*.js"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./tokens.css": "./dist/tokens/tokens.css",
		"./fonts/*": "./dist/fonts/*",
		"./fonts.css": "./dist/fonts/fonts.css",
		"./grove.css": "./dist/styles/grove.css"
	},
	"peerDependencies": {
		"@phosphor-icons/webcomponents": "^2.1.5",
		"lit": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"@phosphor-icons/webcomponents": {
			"optional": true
		}
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.2.1",
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@phosphor-icons/webcomponents": "2.1.5",
		"@storybook/addon-a11y": "10.4.1",
		"@storybook/addon-docs": "10.4.1",
		"@storybook/addon-vitest": "10.4.1",
		"@storybook/web-components": "10.4.1",
		"@storybook/web-components-vite": "10.4.1",
		"@terrazzo/cli": "2.2.0",
		"@terrazzo/plugin-css": "2.2.0",
		"@types/node": "25.9.1",
		"@vitest/coverage-v8": "4.1.7",
		"eslint": "10.4.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-lit": "2.3.1",
		"eslint-plugin-lit-a11y": "5.1.1",
		"eslint-plugin-storybook": "10.4.1",
		"globals": "17.6.0",
		"lit": "3.3.3",
		"prettier": "3.8.3",
		"publint": "0.3.21",
		"storybook": "10.4.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.60.0",
		"unplugin-dts": "1.0.1",
		"vite": "8.0.14",
		"vitest": "4.1.7"
	},
	"keywords": [
		"grove",
		"ui-kit",
		"lit",
		"web-components",
		"components"
	],
	"engines": {
		"node": ">=20"
	}
}
